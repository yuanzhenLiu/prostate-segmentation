{
  "model": {
    "name": "unet",
    "in_channels": 3,
    "out_channels": 1,
    "base_channels": 24,
    "dropout": 0.15,
    "pretrained": false
  },
  "data": {
    "image_size": 512,
    "frame_stride": 4,
    "max_frames_per_group": 180,
    "normalization_mean": [0.485, 0.456, 0.406],
    "normalization_std": [0.229, 0.224, 0.225]
  },
  "augmentation": {
    "horizontal_flip_probability": 0.5,
    "rotation_probability": 0.5,
    "rotation_degrees": 10.0,
    "brightness": 0.08,
    "contrast": 0.08,
    "noise_std": 0.01,
    "blur_probability": 0.05
  },
  "training": {
    "epochs": 35,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.003,
    "patience": 5,
    "min_delta": 0.0001,
    "num_workers": 4,
    "seed": null
  },
  "inference": {
    "threshold": 0.5,
    "overlay_alpha": 0.45,
    "overlay_color_rgb": [255, 0, 0]
  }
}
